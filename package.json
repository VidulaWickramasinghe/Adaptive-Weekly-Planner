{
  "name": "adaptive-weekly-planner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "node --env-file-if-exists=.env.test tests/integration/isolation.mjs && node --env-file-if-exists=.env.test tests/integration/planner.mjs && node --env-file-if-exists=.env.test tests/integration/revisions.mjs && node --env-file-if-exists=.env.test tests/integration/progress-backup.mjs",
    "test:e2e": "playwright test",
    "local:start": "node scripts/start-local.mjs",
    "local:stop": "supabase stack stop",
    "local:setup": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.6",
    "prettier": "3.10.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
